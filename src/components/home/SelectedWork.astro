---
import StateChip from '../StateChip.astro';
import { getProjects } from '../../lib/projects';

const { featured, archived } = await getProjects();
const shownArchived = archived.slice(0, 3);
const moreArchived = archived.length - shownArchived.length;
---

<section id="work" aria-labelledby="work-title">
  <h2 id="work-title" class="section-label">// selected work</h2>

  <div class="cards">
    {
      featured.map((project) => (
        <article class="card project">
          <div class="project__head">
            <h3 class="project__name">
              {project.url ? <a class="link-plain" href={project.url}>{project.name}</a> : project.name}
            </h3>
            <StateChip state={project.state} />
          </div>
          <p class="project__summary">{project.summary}</p>
          <p class="project__stack mono">{project.stack.join(' ')}</p>
        </article>
      ))
    }
  </div>

  {
    archived.length > 0 && (
      <div class="card archived mono">
        <StateChip state="archived" />
        {shownArchived.map((project) => (
          <a href={project.url}>{project.name}</a>
        ))}
        {moreArchived > 0 && (
          <a href="https://github.com/norotaro?tab=repositories&q=wn-">+{moreArchived} WinterCMS plugins</a>
        )}
      </div>
    )
  }
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: var(--space-4);
  }

  .project {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
  }

  .project__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: 0.875rem;
  }

  .project__name {
    font-size: 1.25rem;
  }

  .project__name a {
    color: var(--color-ink);
  }

  .project__name a:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }

  .project__summary {
    margin-bottom: var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-body);
  }

  .project__stack {
    margin-top: auto;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .archived {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 1.25rem;
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    font-size: 0.8125rem;
  }

  .archived a {
    color: var(--color-ink-body);
  }
</style>
