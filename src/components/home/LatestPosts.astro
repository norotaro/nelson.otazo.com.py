---
import { getCollection } from 'astro:content';

interface Props {
  limit?: number;
}

const { limit = 2 } = Astro.props;
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<section class="posts" aria-labelledby="posts-title">
  <h2 id="posts-title" class="section-label">// blog · <span lang="es">escribo en español</span></h2>
  <ul class="card post-list" role="list">
    {
      posts.map((post) => (
        <li>
          <a class="post link-plain" href={`/blog/post/${post.id}`} hreflang="es">
            <time class="post__date mono" datetime={isoDate(post.data.date)}>
              {isoDate(post.data.date)}
            </time>
            <span class="post__title" lang="es">{post.data.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .posts {
    margin-top: var(--space-7);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-list li + li {
    border-top: 1px solid var(--color-divider);
  }

  .post {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-4) var(--space-5);
    color: var(--color-ink);
  }

  .post:hover .post__title {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }

  .post__date {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }

  .post__title {
    font-size: 1rem;
  }
</style>
