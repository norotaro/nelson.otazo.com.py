---
import StateChip from './StateChip.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Heading level inside the page outline. */
  level?: 'h2' | 'h3';
}

const { project, level: Heading = 'h3' } = Astro.props;
const href = project.page ?? project.url;
---

<article class="card project">
  <div class="project__head">
    <Heading class="project__name">
      {href ? <a class="link-plain" href={href}>{project.name}</a> : project.name}
    </Heading>
    <StateChip state={project.state} />
  </div>
  <p class="project__summary">{project.summary}</p>
  <p class="project__stack mono">{project.stack.join(' ')}</p>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
  }

  .project__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: 0.875rem;
  }

  .project__name {
    font-size: 1.25rem;
  }

  .project__name a {
    color: var(--color-ink);
  }

  .project__name a:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }

  .project__summary {
    margin-bottom: var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-body);
  }

  .project__stack {
    margin-top: auto;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
</style>
