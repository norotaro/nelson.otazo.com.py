---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPath, coverFor, isoDate, postAlternates, postLocale, postUrl, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const lang = postLocale(post);
const { Content } = await render(post);
const { title, description, date, category, tags } = post.data;
const cover = coverFor(post);
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpeg' })).src : undefined;
const alternates = await postAlternates(post);
const source = `https://github.com/norotaro/nelson.otazo.com.py/blob/main/src/content/blog/${post.id}.md`;

const copy = {
  en: { fix: 'Found a mistake?', fixLink: 'Propose a fix on GitHub', more: 'More posts', older: '← older', newer: 'newer →' },
  es: { fix: '¿Encontraste un error?', fixLink: 'Propón una corrección en GitHub', more: 'Más artículos', older: '← anterior', newer: 'siguiente →' },
}[lang];
---

<BaseLayout
  title={`${title} · Nelson Otazo`}
  description={description}
  lang={lang}
  ogType="article"
  ogImage={ogImage}
  alternates={alternates}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="alternate" type="application/rss+xml" title="Nelson Otazo · Blog" href={`${blogPath(lang)}/rss.xml`} />
  </Fragment>

  <article class="post">
    <header class="post__head">
      <a class="post__back mono" href={blogPath(lang)}>← /blog</a>
      <h1 class="post__title">{title}</h1>
      <p class="post__meta mono">
        <time datetime={isoDate(date)}>{isoDate(date)}</time>
        {category && <span> · {category}</span>}
        {tags.length > 0 && <span> · {tags.map((tag) => `#${tag}`).join(' ')}</span>}
      </p>
    </header>

    {
      cover && (
        <Image
          class="post__cover"
          src={cover}
          alt=""
          widths={[480, 800, 1200]}
          sizes="(max-width: 48rem) 100vw, 44rem"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="post__foot">
      <p class="post__fix">
        {copy.fix} <a href={source}>{copy.fixLink}</a>.
      </p>

      {
        (newer || older) && (
          <nav class="post__nav" aria-label={copy.more}>
            {older ? (
              <a class="post__link" href={postUrl(older)}>
                <span class="mono">{copy.older}</span>
                <span>{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="post__link post__link--newer" href={postUrl(newer)}>
                <span class="mono">{copy.newer}</span>
                <span>{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-7);
    max-width: 44rem;
  }

  .post__head {
    margin-bottom: var(--space-6);
  }

  .post__back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-size: 0.875rem;
  }

  .post__title {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 5vw, 2.375rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .post__meta {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .post__cover {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .post__foot {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .post__fix {
    margin-bottom: var(--space-5);
    color: var(--color-ink-muted);
  }

  .post__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .post__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-ink);
  }

  .post__link .mono {
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .post__link--newer {
    text-align: right;
  }

  @media (max-width: 47.99rem) {
    .post__nav {
      grid-template-columns: 1fr;
    }

    .post__link--newer {
      text-align: left;
    }
  }

  /* Rendered Markdown: these elements come from the post, not from this template. */
  .prose :global(:is(h2, h3, h4)) {
    margin-block: var(--space-6) var(--space-3);
    font-family: var(--font-mono);
    line-height: 1.3;
  }

  .prose :global(h2) {
    font-size: 1.375rem;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
  }

  .prose :global(:is(p, ul, ol, blockquote, pre, table)) {
    margin-block: 0 var(--space-4);
  }

  .prose :global(:is(p, li)) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-body);
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.5rem;
  }

  .prose :global(li + li) {
    margin-top: var(--space-1);
  }

  .prose :global(img) {
    display: block;
    margin-block: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .prose :global(blockquote) {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    background: var(--color-accent-tint);
    color: var(--color-accent-dark);
    border-radius: 4px;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    padding: var(--space-4);
    overflow-x: auto;
    background: var(--color-surface) !important;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(:is(th, td)) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
  }
</style>
