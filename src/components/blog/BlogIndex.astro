---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import { blogPath, getPosts, isoDate, postUrl } from '../../lib/blog';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const posts = await getPosts(lang);
const rss = `${blogPath(lang)}/rss.xml`;

const copy = {
  en: {
    description: 'Posts about web development, Laravel and PHP by Nelson Otazo.',
    intro: 'I write about web development, Laravel and PHP.',
  },
  es: {
    description: 'Artículos sobre desarrollo web, Laravel y PHP, escritos por Nelson Otazo.',
    intro: 'Escribo sobre desarrollo web, Laravel y PHP.',
  },
}[lang];
---

<BaseLayout title="Blog · Nelson Otazo" description={copy.description} lang={lang}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Nelson Otazo · Blog" href={rss} />

  <section class="blog">
    <header class="blog__head">
      <h1 class="mono">/blog</h1>
      <p>{copy.intro} <a href={rss}>RSS</a></p>
    </header>

    <ol class="card entries" role="list">
      {
        posts.map((post) => (
          <li class="entry">
            <p class="entry__meta mono">
              <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
              {post.data.category && <span> · {post.data.category}</span>}
            </p>
            <h2 class="entry__title">
              <a class="link-plain" href={postUrl(post)}>
                {post.data.title}
              </a>
            </h2>
            <p class="entry__description">{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .blog {
    padding-block: var(--space-7);
    max-width: 50rem;
  }

  .blog__head {
    margin-bottom: var(--space-6);
  }

  .blog__head h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(1.75rem, 5vw, 2.25rem);
  }

  .blog__head p {
    color: var(--color-ink-muted);
  }

  .entries {
    margin: 0;
    padding: 0 var(--space-5);
    list-style: none;
  }

  .entry {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-divider);
  }

  .entry:last-child {
    border-bottom: 0;
  }

  .entry__meta {
    margin-bottom: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .entry__title {
    margin-bottom: var(--space-2);
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .entry__title a:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }

  .entry__description {
    color: var(--color-ink-body);
  }

  @media (max-width: 47.99rem) {
    .entries {
      padding: 0 var(--space-4);
    }
  }
</style>
