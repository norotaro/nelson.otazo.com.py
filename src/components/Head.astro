---
import { Font } from 'astro:assets';
import { alternatesFor } from '../i18n/alternates';
import { pagePath } from '../lib/page-path';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Absolute path of a 1200×630 image under public/. */
  ogImage?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, lang, ogImage = '/og.png', noindex = false, ogType = 'website' } = Astro.props;
const site = Astro.site!;
const canonical = new URL(pagePath(Astro.url), site).href;
const alternates = alternatesFor(pagePath(Astro.url));
const ogLocale = lang === 'es' ? 'es_PY' : 'en_US';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.locale} href={new URL(alt.path, site).href} />
  ))
}
{
  alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.locale === 'en')!.path, site).href} />
  )
}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#f6f6f2" />
<meta name="generator" content={Astro.generator} />
<!-- Search Console ownership, carried over from the previous site. -->
<meta name="google-site-verification" content="ELfyPA2bVB6il83xoP8GzAaNZOodIiUnP0AfcsXVZaQ" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Nelson Otazo" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(ogImage, site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />

<Font cssVariable="--font-mono" preload={[{ weight: 400 }, { weight: 700 }]} />
<Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal' }]} />
