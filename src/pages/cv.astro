---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CV_PDF, cv } from '../data/cv';
import { getJobs } from '../lib/career';
import { getProjects } from '../lib/projects';

const jobs = await getJobs();
const projects = (await getProjects()).featured.filter((project) => project.state !== 'current-role');

const month = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const formatMonth = (yearMonth: string) => month.format(new Date(`${yearMonth}-01T00:00:00Z`));
---

<BaseLayout
  title="CV · Nelson Otazo"
  description="CV of Nelson Otazo, senior software engineer with 15+ years building web products with Laravel and Vue."
  lang="en"
>
  <article class="cv card">
    <header class="cv__head">
      <div>
        <h1 class="cv__name">{cv.name}</h1>
        <p class="cv__headline mono">{cv.headline}</p>
        <p class="cv__location">{cv.location}</p>
      </div>
      <ul class="cv__contact" role="list">
        {cv.contact.map((item) => <li><a class="link-plain" href={item.href}>{item.label}</a></li>)}
      </ul>
    </header>

    <p class="cv__download mono"><a href={CV_PDF} download>download PDF ↓</a></p>

    <section class="cv__section" aria-labelledby="cv-summary">
      <h2 id="cv-summary">Summary</h2>
      {cv.summary.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="cv__section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">Skills</h2>
      <dl class="cv__skills">
        {
          cv.skills.map((skill) => (
            <div>
              <dt>{skill.area}</dt>
              <dd>{skill.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv__section" aria-labelledby="cv-experience">
      <h2 id="cv-experience">Experience</h2>
      {
        jobs.map((job) => (
          <section class="cv__job">
            <h3 class="cv__job-title">
              <span>
                {job.role} · {job.employer}
                {job.client && <span class="cv__client"> (client: {job.client})</span>}
              </span>
              <span class="cv__dates">
                <time class="cv__start" datetime={job.start}>{formatMonth(job.start)}</time> –{' '}
                {job.end ? <time datetime={job.end}>{formatMonth(job.end)}</time> : 'Present'}
              </span>
            </h3>
            <p class="cv__meta">{job.location}</p>
            <ul>
              {[...job.added, ...job.changed, ...job.cvExtra].map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </section>

    <section class="cv__section" aria-labelledby="cv-projects">
      <h2 id="cv-projects">Projects</h2>
      <ul>
        {
          projects.map((project) => (
            <li>
              <strong>{project.url ? <a href={project.url}>{project.name}</a> : project.name}</strong>: {project.summary}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv__section" aria-labelledby="cv-awards">
      <h2 id="cv-awards">Awards</h2>
      <ul>
        {jobs.flatMap((job) => job.awards).map((award) => <li>{award}</li>)}
      </ul>
    </section>

    <section class="cv__section" aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      {
        cv.education.map((entry) => (
          <div class="cv__job">
            <h3 class="cv__job-title">
              <span>{entry.school}</span>
              <span class="cv__dates">{entry.years}</span>
            </h3>
            <p class="cv__meta">{entry.degree}</p>
          </div>
        ))
      }
    </section>

    <section class="cv__section cv__extras" aria-label="Languages and certifications">
      <div>
        <h2>Languages</h2>
        <p>{cv.languages.join(' · ')}</p>
      </div>
      <div>
        <h2>Certifications</h2>
        <p>{cv.certifications.join(' · ')}</p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .cv {
    margin-top: var(--space-6);
    padding: var(--space-6);
    color: var(--color-ink-body);
  }

  .cv__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
  }

  .cv__name {
    font-size: 2rem;
    color: var(--color-ink);
  }

  .cv__headline {
    margin-top: var(--space-2);
    color: var(--color-accent-dark);
  }

  .cv__location,
  .cv__meta {
    color: var(--color-ink-muted);
  }

  .cv__contact {
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .cv__contact a:hover {
    text-decoration: underline;
  }

  .cv__download {
    margin-top: var(--space-4);
  }

  .cv__section {
    margin-top: var(--space-6);
  }

  .cv__section h2 {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--color-divider);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .cv__section p + p {
    margin-top: var(--space-2);
  }

  .cv__section ul {
    padding-left: var(--space-5);
  }

  .cv__skills {
    margin: 0;
  }

  .cv__skills div {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: var(--space-3);
  }

  .cv__skills dt {
    font-weight: 700;
    color: var(--color-ink);
  }

  .cv__skills dd {
    margin: 0;
  }

  .cv__job + .cv__job {
    margin-top: var(--space-4);
  }

  .cv__job,
  .cv__extras > div {
    break-inside: avoid;
  }

  .cv__job-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink);
  }

  .cv__client {
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .cv__dates {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .cv__extras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4) var(--space-6);
  }

  @media (max-width: 40rem) {
    .cv {
      padding: var(--space-5) var(--space-4);
    }

    .cv__skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .cv__skills div + div {
      margin-top: var(--space-2);
    }
  }

  /* The PDF is printed from this page: keep only the CV itself. */
  @page {
    size: Letter;
    margin: 12mm 14mm;
  }

  @media print {
    :global(html body) {
      background: none;
      font-size: 10pt;
      line-height: 1.45;
    }

    /* !important: the footer's scoped display rule outranks any selector from this page. */
    :global(.site-header),
    :global(.footer),
    :global(.skip-link),
    .cv__download {
      display: none !important;
    }

    :global(main.container) {
      max-width: none;
      padding: 0;
    }

    .cv {
      margin: 0;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
    }

    .cv__section {
      margin-top: 1.1em;
    }

    .cv__job + .cv__job {
      margin-top: 0.7em;
    }
  }
</style>
