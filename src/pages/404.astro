---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · Nelson Otazo" description="Page not found." lang="en" noindex>
  <section class="not-found">
    <p class="mono not-found__cmd">$ cd {Astro.url.pathname}</p>
    <h1>404: no such file or directory</h1>
    <p>
      This page does not exist. Go back <a href="/">home</a>, or read the <a href="/blog">blog</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-8);
    max-width: 40rem;
  }
  .not-found__cmd {
    margin-bottom: var(--space-3);
    color: var(--color-ink-muted);
    overflow-wrap: anywhere;
  }
  h1 {
    margin-bottom: var(--space-5);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }
</style>
