---
import Head from '../components/Head.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import type { Alternate } from '../i18n/alternates';
import { t, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Language of this page's content. Required: pages state it rather than derive it from the URL. */
  lang: Locale;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Language alternates when the page is not in the fixed pairs, such as a translated post. */
  alternates?: Alternate[];
}

const { title, description, lang, ogImage, noindex, ogType, alternates } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={title}
      description={description}
      lang={lang}
      ogImage={ogImage}
      noindex={noindex}
      ogType={ogType}
      alternates={alternates}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <header class="container site-header">
      <SiteNav lang={lang} />
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} alternates={alternates} />
  </body>
</html>

<style>
  .site-header {
    padding-top: var(--space-6);
  }

  main:focus {
    outline: none;
  }
</style>
