---
import Head from '../components/Head.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import { t, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /**
   * Language of this page's content. Required and never derived from the URL:
   * Spanish blog posts live at unprefixed paths that i18n routing treats as English.
   */
  lang: Locale;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, lang, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={title} description={description} lang={lang} ogImage={ogImage} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <header class="container site-header">
      <SiteNav lang={lang} />
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  .site-header {
    padding-top: var(--space-6);
  }

  main:focus {
    outline: none;
  }
</style>
